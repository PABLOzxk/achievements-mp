<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AchievementsMP</AssemblyName>
    <RootNamespace>AchievementsMP.App</RootNamespace>
    <Product>Achievements MP</Product>
    <Version>0.7.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Main próprio (App.xaml.cs): o Velopack precisa rodar antes do WPF na instalação e nas atualizações. -->
    <StartupObject>AchievementsMP.App.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AchievementsMP.Core\AchievementsMP.Core.csproj" />
    <ProjectReference Include="..\AchievementsMP.Data\AchievementsMP.Data.csproj" />
    <ProjectReference Include="..\AchievementsMP.Steam\AchievementsMP.Steam.csproj" />
    <ProjectReference Include="..\AchievementsMP.Sync\AchievementsMP.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AchievementsMP.UiTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
