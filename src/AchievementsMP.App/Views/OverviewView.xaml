<UserControl x:Class="AchievementsMP.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,32">
            <TextBlock Text="Visão geral" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Seu progresso em conquistas, em um só lugar." Style="{StaticResource PageSubtitle}" />
    
            <!-- Primeira execução -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Configurar Steam"
                            Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="Conecte sua conta Steam" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Text="Você vai precisar do link do seu perfil e de uma chave pessoal da Steam Web API. Nenhuma senha é pedida." />
                    </StackPanel>
                </DockPanel>
            </Border>
    
            <!-- Indicadores -->
            <UniformGrid Columns="4" Margin="-8,24,-8,0">
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="JOGOS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding GameCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="CONQUISTAS DESBLOQUEADAS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding UnlockedCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="JOGOS EM 100%" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CompletedGames}" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="ACIMA DE 80%" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding NearlyComplete}" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
    
            <!-- Metas e pendentes prioritárias (planejador) -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver metas" FontSize="12" VerticalAlignment="Top"
                                    Command="{Binding OpenGoalsCommand}" />
                            <TextBlock Text="{Binding GoalsHeader}" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ActiveGoals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.OpenGoalsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Maximum="100" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"
                                                             Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" Margin="10,0,0,0" MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding DeadlineText}" FontSize="12" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeadlineText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Deadline}" Value="DueSoon">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Deadline}" Value="Overdue">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasGoals, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Nenhuma meta ativa. Crie uma no Planejador de 100%, aba Metas." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PENDENTES PRIORITÁRIAS" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Flagged}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.OpenFlaggedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="2" Background="{StaticResource InputBrush}" HorizontalAlignment="Left">
                                                <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding GameName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource WarningChip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissable}" Value="True">
                                                                <Setter Property="Background" Value="#55E0523D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                                            <Setter Property="Text" Value="Alta prioridade" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissable}" Value="True">
                                                                    <Setter Property="Text" Value="Perdível" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasFlagged, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Conquistas que você marcar no planejador como perdíveis ou de alta prioridade aparecem aqui." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="MENOS CONQUISTAS FALTANDO" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Closest}" ItemTemplate="{StaticResource GameRow}" ItemContainerStyle="{StaticResource GameListItem}"
                             Style="{StaticResource PlainList}" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Aparece aqui depois da primeira sincronização. Use “Sincronizar agora”, no canto inferior esquerdo." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="MAIS VIÁVEIS DE COMPLETAR" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,10"
                               Text="Ordem pela raridade da conquista mais rara que falta: mostra o quão exclusiva é a parte mais difícil, não quanto tempo falta. Compare com quantas faltam." />
                    <ListBox ItemsSource="{Binding MostViable}" ItemTemplate="{StaticResource GameRow}" ItemContainerStyle="{StaticResource GameListItem}"
                             Style="{StaticResource PlainList}"
                             Visibility="{Binding HasViable, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding HasViable, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Nenhum jogo começado tem todas as conquistas restantes acima de 1% dos jogadores." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
