<UserControl x:Class="AchievementsMP.App.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AchievementsMP.App.ViewModels"
             xmlns:views="clr-namespace:AchievementsMP.App.Views"
             xmlns:conv="clr-namespace:AchievementsMP.App.Converters">
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

        <Style x:Key="RarityChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rarity}" Value="Common"><Setter Property="Background" Value="#33A4D007" /></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Uncommon"><Setter Property="Background" Value="#3366C0F4" /></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Rare"><Setter Property="Background" Value="#33E8B339" /></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="UltraRare"><Setter Property="Background" Value="#33E0523D" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cabeçalho de grupo do plano -->
        <DataTemplate DataType="{x:Type vm:PlanHeaderRow}">
            <StackPanel Margin="0,14,0,6">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissable}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Conquista pendente no plano -->
        <DataTemplate DataType="{x:Type vm:PlanAchievementRow}">
            <Grid MinHeight="56" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="2" Background="{StaticResource InputBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource DangerChip}" Visibility="{Binding IsMissable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Perdível" Style="{StaticResource ChipText}" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource NeutralChip}" Visibility="{Binding EffortLabel, Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Text="{Binding EffortLabel}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource WarningChip}" Visibility="{Binding PriorityLabel, Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource NeutralChip}" Visibility="{Binding Requirement, Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Text="{Binding Requirement}" Style="{StaticResource ChipText}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Style="{StaticResource NeutralChip}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Anotação" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource NeutralChip}" Visibility="{Binding GuidesText, Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Text="{Binding GuidesText}" Style="{StaticResource ChipText}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource RarityChip}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RarityText}" Style="{StaticResource ChipText}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Link de guia -->
        <DataTemplate x:Key="GuideRowTemplate">
            <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remover link"
                        Command="{Binding DataContext.RemoveGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" ToolTip="{Binding UrlText}" FontSize="13"
                        Command="{Binding DataContext.OpenGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="40,32,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Planejador de 100%" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton Style="{StaticResource TabButton}" GroupName="PlannerTabs" Content="Plano do jogo" IsChecked="{Binding IsGameTab, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource TabButton}" GroupName="PlannerTabs" Content="Metas" IsChecked="{Binding IsGoalsTab, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <!-- ═══ Plano do jogo ═══ -->
        <Grid Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding IsGameTab, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="0,0,16,0">
                <ComboBox Width="340" Margin="0,0,10,10" ItemsSource="{Binding GameOptions}" SelectedItem="{Binding SelectedGame}"
                          DisplayMemberPath="Label" ToolTip="Jogo (● = já tem algo planejado)" />
                <ComboBox Width="340" Margin="0,0,10,10" ItemsSource="{Binding StrategyOptions}" SelectedItem="{Binding Strategy}"
                          DisplayMemberPath="Label" ToolTip="Ordem do plano" />
            </WrapPanel>

            <!-- Cabeçalho do jogo -->
            <Grid Grid.Row="1" Margin="0,6,16,8" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="3" Background="{StaticResource InputBrush}" VerticalAlignment="Top" Margin="0,2,16,0">
                    <Image Source="{Binding Game.IconUrl, TargetNullValue={x:Null}}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Game.Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="13" Margin="0,2,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Maximum="100" Value="{Binding Game.Percent, Mode=OneWay}" VerticalAlignment="Center"
                                     Visibility="{Binding Game.ShowBar, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Game.Percent, StringFormat={}{0:0}%}" FontSize="12" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding Game.ShowBar, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Ver conquistas" Command="{Binding OpenDetailsCommand}" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="Criar meta de 100%" Command="{Binding CreateGameGoalCommand}" Padding="12,6" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Nenhum jogo -->
            <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="720" Margin="0,8,16,0"
                    Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding EmptyText}" />
            </Border>

            <Grid Grid.Row="2" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Lista do plano -->
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}"
                           Text="Nenhuma conquista pendente com dados da Steam."
                           Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}" />
                <ListBox x:Name="PlanList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRowItem}"
                         SelectionChanged="OnPlanSelectionChanged"
                         Background="Transparent" BorderThickness="0" Padding="0,0,8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" Margin="0,0,0,2" Padding="12,0" CornerRadius="2"
                                                BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Cabeçalhos de grupo: só texto, sem clique nem foco. -->
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Painel da direita: classificação, checklist e guias do jogo -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel Margin="0,0,0,24">
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="CLASSIFICAR CONQUISTA" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Body}" FontSize="13"
                                           Text="Clique numa conquista da lista para marcar se é perdível, rápida ou demorada, anotar requisitos e guardar links de guia. A Steam não fornece esses dados: o que você não marcar fica como “não sei”." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DataContext="{Binding Editor}">
                                <TextBlock Text="CLASSIFICAR CONQUISTA" Style="{StaticResource SectionTitle}" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="2" Background="{StaticResource InputBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        <Border Style="{StaticResource RarityChip}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding RarityText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Pode ser perdida?" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:AchievementEditor.MissableOptions}" SelectedItem="{Binding Missable}" DisplayMemberPath="Label" />
                                <TextBlock Text="Esforço" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:AchievementEditor.EffortOptions}" SelectedItem="{Binding Effort}" DisplayMemberPath="Label" />
                                <TextBlock Text="Prioridade" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:AchievementEditor.PriorityOptions}" SelectedItem="{Binding Priority}" DisplayMemberPath="Label" />
                                <TextBlock Text="Requisito especial" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Requirement, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: multijogador, DLC, dificuldade máxima" />
                                <TextBlock Text="Fonte" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Tag="Onde você confirmou (guia, site, fórum)" />
                                <TextBlock Text="Anotação" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Tag="O que fazer, onde, em que momento…"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto" />

                                <TextBlock Text="Guias desta conquista" Style="{StaticResource FieldLabel}" />
                                <ItemsControl ItemsSource="{Binding Guides}" ItemTemplate="{StaticResource GuideRowTemplate}" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Adicionar" Padding="10,6" Margin="8,0,0,0"
                                            Command="{Binding DataContext.AddAchievementGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <TextBox Text="{Binding NewGuideUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Cole o link do guia">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.AddAchievementGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <TextBlock Text="{Binding GuideError}" Style="{StaticResource Hint}" Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding GuideError, Converter={StaticResource NotNullToVisibility}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Padding="16,6"
                                            Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <TextBlock Text="{Binding DataContext.SaveStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Também salva sozinho ao escolher outra conquista ou sair da tela." />
                            </StackPanel>
                        </Border>

                        <!-- Checklist -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TaskSummary}" Style="{StaticResource Hint}" Margin="0" />
                                    <TextBlock Text="CHECKLIST DO JOGO" Style="{StaticResource SectionTitle}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Subir"
                                                            Command="{Binding DataContext.MoveTaskUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Descer"
                                                            Command="{Binding DataContext.MoveTaskDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Excluir tarefa"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding DoneText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                   Visibility="{Binding DoneText, Converter={StaticResource NotNullToVisibility}}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="Adicionar" Command="{Binding AddTaskCommand}" Padding="10,6" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Tag="Nova tarefa (ex.: farmar ouro antes do capítulo 3)">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Guias do jogo -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="GUIAS DO JOGO" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding GameGuides}" ItemTemplate="{StaticResource GuideRowTemplate}" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Adicionar" Command="{Binding AddGameGuideCommand}" Padding="10,6" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding NewGameGuideUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Cole o link de um guia 100%">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddGameGuideCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <TextBlock Text="{Binding GameGuideError}" Style="{StaticResource Hint}" Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding GameGuideError, Converter={StaticResource NotNullToVisibility}}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Os links abrem no navegador. Só páginas web (http/https) são aceitas." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══ Metas ═══ -->
        <views:GoalsView Grid.Row="1" Margin="0,16,0,0" DataContext="{Binding Goals}"
                         Visibility="{Binding DataContext.IsGoalsTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
