<UserControl x:Class="AchievementsMP.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Número do passo -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOk}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Selo "Pronto" / "Falta ajustar" -->
        <Style x:Key="StepBadge" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOk}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="#33A4D007" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="#33E8B339" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Resposta da verificação para o passo -->
        <Style x:Key="StepMessage" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOk}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Message}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Primeiros passos" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Três passos e o app passa a ler suas conquistas da Steam. Nenhuma senha é pedida, e nada sai deste computador além das consultas à Steam." />

            <!-- 1. Perfil -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <DockPanel DataContext="{Binding ProfileStep}">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Seu perfil Steam" Style="{StaticResource StepTitle}" />
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource ChipText}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Step}" Margin="0,12,0,0"
                               Text="Abra seu perfil no navegador e copie o endereço da barra (algo como steamcommunity.com/id/seunome). Também serve o SteamID64, de 17 dígitos." />
                    <Button Style="{StaticResource LinkButton}" Content="Abrir meu perfil na Steam" Command="{Binding OpenProfilePageCommand}" HorizontalAlignment="Left" Margin="0,6,0,8" />
                    <TextBox Text="{Binding SteamProfile, UpdateSourceTrigger=PropertyChanged}" Tag="Cole aqui o link do seu perfil" />
                    <TextBlock Text="{Binding ProfileHint}" Style="{StaticResource Hint}" />
                    <TextBlock DataContext="{Binding ProfileStep}" Text="{Binding Message}" Style="{StaticResource StepMessage}" />
                </StackPanel>
            </Border>

            <!-- 2. Chave -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel DataContext="{Binding KeyStep}">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Sua chave da Steam Web API" Style="{StaticResource StepTitle}" />
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource ChipText}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Step}" Margin="0,12,0,0"
                               Text="É uma chave pessoal e gratuita que deixa o app ler (só ler) seus dados da Steam." />
                    <TextBlock Style="{StaticResource Step}" Text="a) Clique em “Abrir página da chave” e entre na sua conta Steam, se o site pedir." />
                    <TextBlock Style="{StaticResource Step}" Text="b) No campo do domínio (“Domain Name”), escreva localhost. O app não usa esse campo." />
                    <TextBlock Style="{StaticResource Step}" Text="c) Marque que concorda com os termos de uso e clique em registrar (“Register”)." />
                    <TextBlock Style="{StaticResource Step}" Text="d) Copie a chave que aparecer (“Key”, 32 letras e números) e cole abaixo." />
                    <Button Style="{StaticResource LinkButton}" Content="Abrir página da chave" Command="{Binding OpenApiKeyPageCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" />
                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyChanged" />
                    <TextBlock Text="{Binding KeyShapeWarning}" Style="{StaticResource Hint}" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="{Binding SavedKeyText}" Style="{StaticResource Hint}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="A Steam só libera a chave para contas que já gastaram pelo menos US$ 5 na loja. Se a página disser que sua conta é limitada, é isso." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Trate a chave como uma senha: não passe para ninguém e não cole em sites, porque golpistas usam chaves para enganar em trocas. Aqui ela fica só neste PC, criptografada pelo Windows." />
                    <TextBlock DataContext="{Binding KeyStep}" Text="{Binding Message}" Style="{StaticResource StepMessage}" />
                </StackPanel>
            </Border>

            <!-- 3. Privacidade -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel DataContext="{Binding PrivacyStep}">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Privacidade do perfil" Style="{StaticResource StepTitle}" />
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource ChipText}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Step}" Margin="0,12,0,0"
                               Text="A Steam só informa conquistas de perfis públicos. Nas configurações de privacidade, deixe “Meu perfil” e “Detalhes do jogo” como Público." />
                    <Button Style="{StaticResource LinkButton}" Content="Abrir configurações de privacidade" Command="{Binding OpenPrivacyPageCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    <TextBlock DataContext="{Binding PrivacyStep}" Text="{Binding Message}" Style="{StaticResource StepMessage}" />
                </StackPanel>
            </Border>

            <!-- Verificar -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Verificar" Command="{Binding CheckCommand}" />
                <Button Content="Concluir e buscar conquistas" Margin="10,0,0,0" Command="{Binding FinishCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Body}" Margin="0,10,0,0" TextWrapping="Wrap" />

            <!-- 4. Backup -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="RECOMENDADO: BACKUP" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Step}"
                               Text="O que você anotar e planejar no app fica só neste computador. Escolha uma pasta do OneDrive, Google Drive ou um pendrive e o app guarda uma cópia por dia lá." />
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Escolher pasta" Command="{Binding ChooseBackupFolderCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding BackupText}" Style="{StaticResource Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding BackupMessage}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
