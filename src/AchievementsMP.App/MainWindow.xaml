<Window x:Class="AchievementsMP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AchievementsMP.App.ViewModels"
        xmlns:views="clr-namespace:AchievementsMP.App.Views"
        Title="Achievements MP" Icon="Assets/app.ico" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameDetailsViewModel}"><views:GameDetailsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlannerViewModel}"><views:PlannerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}"><views:SetupView /></DataTemplate>

        <DataTemplate x:Key="NavContent">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navegação lateral. Rola só quando a janela é baixa demais para tudo caber; senão o rodapé fica colado embaixo. -->
        <ScrollViewer Grid.Column="0" Grid.Row="0" Background="{StaticResource WindowBrush}" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Perfil: foto e nome da Steam, ou os escolhidos pelo usuário. -->
                <Button Grid.Row="0" Style="{StaticResource ProfileCard}" Margin="0,14,0,10" DataContext="{Binding Profile}"
                        Command="{Binding EditCommand}" ToolTip="Trocar foto e nome" AutomationProperties.Name="Editar perfil">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Width="44" Height="44" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource AvatarCircle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="12,0,6,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}"
                                         IsChecked="{Binding IsActive, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"
                                         Content="{Binding}" ContentTemplate="{StaticResource NavContent}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Atualização baixada e pronta -->
                <Border Grid.Row="3" Margin="16,0,16,12" Padding="12" CornerRadius="4" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1,0,0,0"
                        DataContext="{Binding Updater}"
                        Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                            <Run Text="Versão" /> <Run Text="{Binding ReadyVersion, Mode=OneWay}" /> <Run Text="pronta para instalar." />
                        </TextBlock>
                        <Button Content="Reiniciar e atualizar" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,8,0,0"
                                Command="{Binding DataContext.RestartToUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Border>

                <!-- Sincronização -->
                <Border Grid.Row="4" Margin="16,0,16,12" Padding="12" CornerRadius="4" Background="{StaticResource CardBrush}"
                        DataContext="{Binding Sync}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" MaxHeight="96" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Margin="0,8,0,0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,10,0,0">
                            <Button Style="{StaticResource QuietButton}" Command="{Binding SyncNowCommand}" HorizontalAlignment="Left"
                                    ToolTip="Buscar agora o que mudou na Steam"
                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sincronizar agora" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuietButton}" Content="Cancelar" Command="{Binding CancelCommand}" HorizontalAlignment="Left"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Image Grid.Row="5" Source="Assets/logo.png" Width="200" Margin="16,4,16,18" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Achievements MP: rumo ao 100%" />
            </Grid>
        </ScrollViewer>

        <!-- Conteúdo -->
        <!-- Cada página cuida da própria rolagem (a biblioteca precisa de virtualização). -->
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource SurfaceGradientBrush}">
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </Border>

        <!-- Rodapé -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource WindowBrush}" Padding="20,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status.Text}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
