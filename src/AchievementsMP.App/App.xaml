<Application x:Class="AchievementsMP.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AchievementsMP.App.Converters"
             xmlns:vm="clr-namespace:AchievementsMP.App.ViewModels"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:WebImageConverter x:Key="WebImage" />
            <conv:AvatarImageConverter x:Key="AvatarImage" />

            <!--
                Foto do perfil em círculo: a escolhida, senão a da Steam, senão a inicial do nome (ou um ícone de pessoa).
                A da Steam carrega da internet; até chegar (ou sem internet), a inicial aparece por baixo.
                Escala com o tamanho de quem usa o modelo (barra lateral e janela "Seu perfil").
            -->
            <DataTemplate x:Key="AvatarCircle">
                <Viewbox>
                    <Grid Width="100" Height="100" TextOptions.TextFormattingMode="Ideal" RenderOptions.BitmapScalingMode="HighQuality">
                        <Ellipse Fill="{StaticResource AccentDarkBrush}" />
                        <TextBlock Text="{Binding Initial}" FontSize="46" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasInitial, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="44" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasInitial, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding SteamAvatarUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CustomAvatar, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Viewbox>
            </DataTemplate>

            <!-- Linha de jogo (biblioteca e visão geral). Clique ou Enter abre os detalhes. -->
            <Style x:Key="GameListItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnGameRowClick" />
                <EventSetter Event="KeyDown" Handler="OnGameRowKeyDown" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{StaticResource CardBrush}" Margin="0,0,0,2" Padding="12,0" CornerRadius="2"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Lista sem rolagem própria (dentro de páginas que já rolam): não "rouba" a roda do mouse. -->
            <Style x:Key="PlainList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ViabilityChip" TargetType="Border" BasedOn="{StaticResource Chip}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Viability}" Value="Unknown"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    <!-- 100%: no lugar do chip aparece o troféu (CompletionTrophy). -->
                    <DataTrigger Binding="{Binding Viability}" Value="Done"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    <DataTrigger Binding="{Binding Viability}" Value="High"><Setter Property="Background" Value="#33A4D007" /></DataTrigger>
                    <DataTrigger Binding="{Binding Viability}" Value="Medium"><Setter Property="Background" Value="#3366C0F4" /></DataTrigger>
                    <DataTrigger Binding="{Binding Viability}" Value="Low"><Setter Property="Background" Value="#33E8B339" /></DataTrigger>
                    <DataTrigger Binding="{Binding Viability}" Value="VeryLow"><Setter Property="Background" Value="#33E0523D" /></DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Marca de jogo emprestado da Família Steam (DataContext = LibraryItem). -->
            <Style x:Key="FamilyChip" TargetType="Border" BasedOn="{StaticResource Chip}">
                <Setter Property="Background" Value="#3D9B6BFF" />
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="ToolTip" Value="{x:Static vm:LibraryItem.FamilyTooltip}" />
                <Setter Property="Visibility" Value="{Binding IsFamily, Converter={StaticResource BoolToVisibility}}" />
            </Style>

            <!-- Troféu dourado de jogo 100% (DataContext = LibraryItem). Some nos jogos incompletos. -->
            <Style x:Key="CompletionTrophy" TargetType="Image">
                <Setter Property="Source" Value="pack://application:,,,/AchievementsMP;component/Assets/trofeu-100.png" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                <Setter Property="ToolTip" Value="100%: todas as conquistas desbloqueadas" />
                <Setter Property="Visibility" Value="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}" />
            </Style>

            <DataTemplate x:Key="GameRow">
                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="2" Background="{StaticResource InputBrush}" HorizontalAlignment="Left">
                        <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Favorito"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource FamilyChip}" Margin="8,0,0,0">
                                <TextBlock Text="Família" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PlaytimeText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="0,0,12,0" ToolTip="{Binding BadgeTooltip}">
                        <Border.Visibility>
                            <Binding Path="Badge">
                                <Binding.Converter>
                                    <conv:NotNullToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </Border.Visibility>
                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ViabilityChip}" ToolTip="{Binding ViabilityTooltip}">
                        <TextBlock Text="{Binding ViabilityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <Image Grid.Column="3" Style="{StaticResource CompletionTrophy}" Source="pack://application:,,,/AchievementsMP;component/Assets/trofeu-100-pequeno.png" Width="34" Height="34"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource GamePercentText}"
                                       Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource GameProgress}" Margin="0,5,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                     Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
